# NextTrack — enrichment pipeline configuration.
# Copy this file to `.env` and fill in your keys. All keys are OPTIONAL:
# the pipeline runs keyless (MusicBrainz + AcousticBrainz are free, no key),
# and these two just add extra fields.

# Last.fm API key -> real popularity (listener counts).
# Free: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# YouTube Data API v3 key -> an embeddable video id per track for playback.
# Free: https://console.cloud.google.com/  (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Contact string embedded in the MusicBrainz User-Agent (their guidelines ask
# for a way to reach you). Any email or project URL is fine.
MUSICBRAINZ_CONTACT=your-email@example.com
